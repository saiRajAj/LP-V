# ============================================================
# 16. COMPARE KNN AND SVM
# ============================================================
results = pd.DataFrame({
    &quot;Model&quot;: [
        &quot;KNN&quot;,
        &quot;SVM&quot;
    ],
    &quot;Accuracy&quot;: [
